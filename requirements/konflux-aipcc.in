# Extra dependencies for the Konflux (RHOAI) container build that are
# not declared in pyproject.toml.
#
# To regenerate the lock file (requirements/konflux-aipcc-requirements.txt), run:
#
#   python requirements/compile.py
#
# pyproject.toml is used as input because it contains all mlflow dependencies
# inline (unlike pyproject.release.toml which references mlflow-skinny and
# mlflow-tracing as separate packages that may not yet be on the AIPCC index).
# mlflow is excluded from the output (--no-emit-package) because it is built
# from source in the Dockerfile using pyproject.release.toml.
#
# Packages not on the AIPCC Python package index (psycopg2, prometheus-flask-exporter)
# are installed separately in the Dockerfile via Cachi2 prefetch.

boto3
prometheus-client
# Required by mlflow-kubernetes-plugins, whose wheel is installed with --no-deps.
kubernetes==35.0.0
# Protobuf 7.34.1 crashes while importing MLflow's generated descriptors on
# s390x. Version 7.35.1 passes the descriptor import check there (protobuf#29651).
protobuf==7.34.1; platform_machine != "s390x"
protobuf==7.35.1; platform_machine == "s390x"

# Cross-arch constraints: pin packages to versions available on all target
# architectures (aarch64, ppc64le, x86_64) on the AIPCC index.
jiter==0.14.0
litellm<2,>=1.0.0
matplotlib==3.10.8
numpy==2.4.4
pyarrow<23.0.1
pydantic==2.13.1
regex==2026.4.4
rpds-py==0.30.0
scikit-learn==1.8.0
sqlalchemy==2.0.49
tiktoken==0.12.0
tokenizers==0.22.2
yarl==1.23.0

# CVE-2026-112895
# CVE-2026-59199
pillow>=13.0.0

# pyasn1 0.6.4+ fixes CVE-2026-59884 (DoS via crafted BER/CER/DER long-form tag IDs).
pyasn1>=0.6.4

# Security constraints for shipped runtime dependencies.
# GitPython 3.1.60+ validates git directory locations before repository operations.
gitpython>=3.1.60
# sqlparse 0.6.0+ bounds work while lexing and grouping adversarial SQL.
sqlparse>=0.6.0
